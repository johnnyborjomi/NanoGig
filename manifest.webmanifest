{
  "name": "NanoGig (unofficial gig view for Nano Cortex)",
  "short_name": "NanoGig",
  "description": "Unofficial live preset name and FX block display for the Neural DSP Nano Cortex over Bluetooth LE. Not affiliated with Neural DSP.",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "orientation": "landscape",
  "background_color": "#07090c",
  "theme_color": "#07090c",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
