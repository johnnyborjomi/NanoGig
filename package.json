{
  "name": "nanogig",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "NanoGig: unofficial stage gig view for the Neural DSP Nano Cortex over Web Bluetooth",
  "license": "MIT",
  "repository": "github:johnnyborjomi/NanoGig",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:open": "npx cap open ios"
  },
  "devDependencies": {
    "@types/web-bluetooth": "^0.0.21",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/status-bar": "^8.0.3",
    "lucide": "^1.45.0"
  }
}
